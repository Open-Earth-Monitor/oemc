          "==",
          [
            "get",
            "disputed"
          ],
          1
        ]
      ],
      "paint": {
        "line-color": "hsl(0,0%,0%)",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          3,
          2.5,
          5,
          3,
          12,
          6
        ],
        "line-opacity": 0.35
      }
    },
    {
