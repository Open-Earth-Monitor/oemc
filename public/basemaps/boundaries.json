{
  "version": 8,
  "name": "OEMC country boundaries",
  "metadata": {
    "ol:webfonts": ""
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "layers": [
    {
      "id": "boundary_2_casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": [
        "all",
        [
          "==",
          [
            "get",
            "admin_level"
          ],
          2
        ],
        [
          "!=",
          [
            "get",
            "maritime"
          ],
          1
        ],
        [
          "!=",
          [
            "get",
            "disputed"
          ],
          1
        ],
        [
          "!",
          [
            "has",
            "claimed_by"
          ]
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "hsl(0,0%,0%)",
        "line-opacity": 0.35,
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          3,
          2.5,
          5,
          3,
          12,
          6
        ]
      }
    },
    {
      "id": "boundary_disputed_casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": [
